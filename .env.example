# URL of the deployed Supabase Edge Function in supabase/functions/ai
EXPO_PUBLIC_AI_URL=https://YOUR-PROJECT.supabase.co/functions/v1/ai

# Supabase project (Project Settings -> API). The anon key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
