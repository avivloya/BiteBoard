# URL of the deployed Supabase Edge Function in supabase/functions/ai
EXPO_PUBLIC_AI_URL=https://YOUR-PROJECT.supabase.co/functions/v1/ai

# Supabase project (Project Settings -> API). The anon key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (Project -> API keys). Entitlement id must be "pro".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
